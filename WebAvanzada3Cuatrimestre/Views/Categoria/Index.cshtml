@{
    ViewData["Title"] = "Categorías";
}

<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/carro.css" asp-append-version="true" />


<div class="duenno-page">

    <div class="page-header">
        <div class="page-header-content">
            <div>
                <h1 class="page-title">
                    <i class="bi bi-tags-fill"></i> Categorías
                </h1>
                <p class="page-subtitle">Gestión de las categorías de productos médicos</p>
            </div>
            <button type="button" class="btn btn-crear" data-bs-toggle="modal" data-bs-target="#modalCrearCategoria">
                <i class="bi bi-plus-lg"></i> Nueva Categoría
            </button>
        </div>
    </div>

    <div class="table-card">
        <div class="table-card-header">
            <h2 class="table-card-title">
                <i class="bi bi-list-ul"></i> Lista de Categorías
            </h2>
        </div>
        <div class="table-responsive">
            <table id="tblCategoria" class="table table-duenno" style="width:100%">
                <thead>
                    <tr>
                        <th style="width:6%"><div class="th-content"><i class="bi bi-hash"></i> Id</div></th>
                        <th><div class="th-content"><i class="bi bi-tag"></i> Nombre</div></th>
                        <th style="width:14%"><div class="th-content"><i class="bi bi-gear"></i> Acciones</div></th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>

    @await Html.PartialAsync("_Create", new WebAvanzada3Cuatrimestre.Application.Dtos.CategoriaDto())
    @await Html.PartialAsync("_Edit", new WebAvanzada3Cuatrimestre.Application.Dtos.CategoriaDto())
</div>

@section Scripts {
    <script src="~/js/categoria.js" asp-append-version="true"></script>
}