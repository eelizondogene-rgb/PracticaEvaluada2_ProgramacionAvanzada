@{
    ViewData["Title"] = "Inicio";
}
<div class="home-page">
    <section class="home-heading">
        <p class="eyebrow"><i class="bi bi-grid-1x2" aria-hidden="true"></i> Panel</p>
        <h1>Productos <span>médicos</span></h1>
        <p>Administración del catálogo de productos médicos.</p>
    </section>

    <a class="home-feature" asp-controller="Categoria" asp-action="Index">
        <span class="home-feature-icon" aria-hidden="true"><i class="bi bi-tags"></i></span>
        <div class="home-feature-copy">
            <span class="home-feature-label">Módulo</span>
            <h2>Categorías</h2>
            <p>Consultar, registrar y actualizar las categorías del catálogo.</p>
        </div>
        <span class="home-feature-link">Abrir módulo <i class="bi bi-arrow-right" aria-hidden="true"></i></span>
    </a>
</div>
