@using WebAvanzada3Cuatrimestre.Application.Dtos
@{
    ViewData["Title"] = "Productos";
    var categorias = ViewBag.Categorias as List<CategoriaDto> ?? new List<CategoriaDto>();
}

<div class="duenno-page">
    <div class="page-header">
        <div class="page-header-content">
            <div>
                <h1 class="page-title"><i class="bi bi-capsule"></i> Productos</h1>
                <p class="page-subtitle">Gestión de productos médicos</p>
            </div>
            <button type="button" class="btn btn-crear" data-bs-toggle="modal" data-bs-target="#modalCrearProducto">
                <i class="bi bi-plus-lg"></i> Nuevo Producto
            </button>
        </div>
    </div>
    <div class="table-card">
        <div class="table-card-header">
            <h2 class="table-card-title"><i class="bi bi-list-ul"></i> Lista de Productos</h2>
        </div>
        <div class="table-responsive">
            <table id="tblProducto" class="table table-duenno" style="width:100%">
                <thead>
                    <tr>
                        <th class="col-id" style="width:6.5rem"><div class="th-content"><i class="bi bi-hash"></i> Id</div></th>
                        <th class="col-nombre"><div class="th-content"><i class="bi bi-capsule"></i> Nombre</div></th>
                        <th class="col-categoria" style="width:22%"><div class="th-content"><i class="bi bi-tags"></i> Categoría</div></th>
                        <th class="col-acciones" style="width:8.75rem"><div class="th-content"><i class="bi bi-gear"></i> Acciones</div></th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
    @await Html.PartialAsync("_Create", new ProductoDto(), new ViewDataDictionary(ViewData) { ["Categorias"] = categorias })
    @await Html.PartialAsync("_Edit", new ProductoDto(), new ViewDataDictionary(ViewData) { ["Categorias"] = categorias })
</div>

@section Scripts {
    <script src="~/js/producto.js" asp-append-version="true"></script>
}
